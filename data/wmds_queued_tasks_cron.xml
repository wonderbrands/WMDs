<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron to process queued tasks as fallback -->
        <record id="ir_cron_process_wmds_queued_tasks" model="ir.cron">
            <field name="name">WMDs: Process Queued Tasks Fallback</field>
            <field name="model_id" search="[('model', '=', 'wmds.queued_tasks')]"/>
            <field name="state">code</field>
            <field name="code">model._process_tasks_thread(model.env.registry, model.env.cr.dbname)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron to clean up old queued tasks -->
        <record id="ir_cron_cleanup_wmds_queued_tasks" model="ir.cron">
            <field name="name">WMDs: Clean Up Old Queued Tasks</field>
            <field name="model_id" search="[('model', '=', 'wmds.queued_tasks')]"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_tasks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
