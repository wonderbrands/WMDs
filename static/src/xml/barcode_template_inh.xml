<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'o_barcode_partner')]" position="replace">
            <div class="o_barcode_partner text-muted d-flex align-items-center">
                <i class="fa fa-user-circle-o me-1"/>
                <span t-if="env.model.record and env.model.record.operator and env.model.record.operator.length > 1">
                    <t t-esc="env.model.record.operator[1]"/>
                </span>
                <span t-elif="env.model.record and env.model.record.partner_id and env.model.record.partner_id.length > 1">
                    <t t-esc="env.model.record.partner_id[1]"/>
                </span>
                <span t-else="">
                    Sin operador
                </span>
            </div>
        </xpath>

        <!--<xpath expr="//button[contains(@class, 'o_add_line')]" position="before">
            <button t-if="env.model.record and env.model.record.name and env.model.record.name.includes('PACK')" 
                    class="btn btn-primary" 
                    t-on-click="() => this.onCustomAction('action_imprimir_guia')">
                <i class="fa fa-print me-1"/> Imprimir Guía de Envío
            </button>
        </xpath>-->

        <xpath expr="//button[contains(@class, 'o_add_line')]" position="attributes">
            <attribute name="t-att-style">
                (env.model.record and env.model.record.name and env.model.record.name.includes('PACK')) ? 'display: none !important;' : ''
            </attribute>
        </xpath>


        <!--<xpath expr="//button[contains(@class, 'o_put_in_pack')]" position="before">
            <button t-if="env.model.record and env.model.record.name and env.model.record.name.includes('PACK')" 
                    class="btn btn-secondary" 
                    t-on-click="() => this.onCustomAction('action_print_tag')">
                <i class="fa fa-tag me-1"/> Imprimir Etiqueta de la Orden
            </button>
        </xpath>-->

        <xpath expr="//button[contains(@class, 'o_put_in_pack')]" position="attributes">
            <attribute name="t-att-style">
                (env.model.record and env.model.record.name and env.model.record.name.includes('PACK')) ? 'display: none !important;' : ''
            </attribute>
        </xpath>

    </t>
</templates>