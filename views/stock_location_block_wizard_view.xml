<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_location_block_wizard_form" model="ir.ui.view">
        <field name="name">stock.location.block.wizard.form</field>
        <field name="model">stock.location.block.wizard</field>
        <field name="arch" type="xml">
            <form string="Bloquear Ubicación">
                <group>
                    <field name="location_id" readonly="1" force_save="1"/>
                    <field name="block_reason" placeholder="Ej: Reservado para inventario, Ubicación dañada, etc."/>
                </group>
                <footer>
                    <button name="action_block" string="Bloquear" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_location_block_wizard" model="ir.actions.act_window">
        <field name="name">Bloquear Ubicación</field>
        <field name="res_model">stock.location.block.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
