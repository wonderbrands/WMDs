<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wmds_po_inherit" model="ir.ui.view">
            <field name="name">wmds.po.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="action_comex_approve"
                            string="✓ VoBo COMEX"
                            type="object"
                            class="btn-warning"
                            invisible="check_commertial or state not in ('purchase', 'done')"
                            confirm="¿Confirma el Visto Bueno de COMEX? Se trasladará el stock de Cuarentena a Almacenaje."/>
                </xpath>

                <xpath expr="//field[@name='state']/.." position="after">
                    <field name="check_commertial" invisible="1"/>
                    <div class="badge rounded-pill text-bg-success fs-6 lh-base"
                         invisible="not check_commertial">
                        ✓ VoBo COMEX
                    </div>
                    <div class="badge rounded-pill text-bg-warning fs-6 lh-base"
                         invisible="check_commertial or state not in ('purchase', 'done')">
                        ⏳ Pendiente COMEX
                    </div>
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_quarantine_transfers"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            invisible="quarantine_transfer_count == 0">
                        <field name="quarantine_transfer_count"
                               widget="statinfo"
                               string="Liberaciones"/>
                    </button>
                </xpath>

                <xpath expr="//group[@name='other_info']" position="inside">
                    <field name="check_commertial" readonly="1"
                           widget="boolean_toggle"/>
                    <field name="comex_release_date"
                           invisible="not check_commertial"/>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="WMDS" name="wmds_logs">
                        <field name="wmds_log">
                            <list>
                                <field name="log"/>
                                <field name="date"/>
                                <field name="user"/>
                            </list>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="wmds_picking_form_comex" model="ir.ui.view">
            <field name="name">wmds.picking.form.comex</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="comex_source_po_id"
                           invisible="not comex_source_po_id"
                           readonly="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>