<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_wmds" model="ir.ui.view">
        <field name="name">stock.move.form.wmds</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_grp']" position="after">
                <group string="WMDS Logistic Status" name="wmds_status">
                    <group>
                        <field name="wmds_state" widget="badge" decoration-success="wmds_state == 'dispatched'" decoration-warning="wmds_state == 'partially_dispatched'" decoration-info="wmds_state in ['on_bin', 'on_dock']"/>
                        <field name="on_bin" readonly="1"/>
                        <field name="bin_id" readonly="1"/>
                        <field name="qty_dispatched" readonly="1"/>
                        <field name="qty_remaining" readonly="1"/>
                        <field name="dispatched" readonly="1"/>
                    </group>
                    <group>
                        <field name="on_dock" readonly="1"/>
                        <field name="dock_id" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_wmds" model="ir.ui.view">
        <field name="name">stock.move.list.wmds</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="wmds_picked_qty" string="Recolectado (WMDS)"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="wmds_state" widget="badge" decoration-success="wmds_state == 'dispatched'" decoration-warning="wmds_state == 'partially_dispatched'" decoration-info="wmds_state in ['on_bin', 'on_dock']" optional="show"/>
                <field name="on_bin" optional="show"/>
                <field name="bin_id" optional="hide"/>
                <field name="on_dock" optional="show"/>
                <field name="dock_id" optional="hide"/>
                <field name="qty_dispatched" optional="show"/>
                <field name="qty_remaining" optional="show"/>
                <field name="dispatched" optional="show"/>
            </xpath>
        </field>
    </record>


</odoo>