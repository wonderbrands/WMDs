<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="comex_release_wizard_form" model="ir.ui.view">
        <field name="name">comex.release.wizard.form</field>
        <field name="model">comex.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Liberación COMEX">
                <header>
                    <button name="action_confirm_release"
                            string="✓ Confirmar Liberación"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cerrar" special="cancel"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>
                            <span>Liberación COMEX para </span>
                            <field name="purchase_order_name" readonly="1"
                                   class="d-inline"/>
                        </h2>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not has_warnings">
                        <field name="warning_message" nolabel="1"
                               readonly="1"/>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <p class="mb-0">
                            <strong>Revise el stock en cuarentena.</strong>
                            Marque las líneas a trasladar, ajuste cantidades
                            si es necesario y confirme. Se crearán traslados
                            internos de Cuarentena → Almacenaje.
                        </p>
                    </div>

                    <field name="purchase_order_id" invisible="1"/>
                    <field name="has_warnings" invisible="1"/>

                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="to_transfer"
                                   widget="boolean_toggle"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"
                                   optional="show"/>
                            <field name="quantity_in_quarantine"
                                   readonly="1"
                                   sum="Total Cuarentena"/>
                            <field name="reserved_quantity" readonly="1"
                                   optional="hide"/>
                            <field name="available_quantity" readonly="1"
                                   sum="Total Disponible"/>
                            <field name="quantity_to_transfer"
                                   sum="Total a Trasladar"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="quarantine_location_id"
                                   readonly="1"/>
                            <field name="storage_location_id"/>
                            <field name="has_related_move"
                                   widget="boolean"
                                   optional="show"
                                   string="Trazado"/>
                        </list>
                    </field>

                    <group class="mt-3">
                        <group>
                            <field name="auto_validate"/>
                        </group>
                        <group>
                            <field name="notes"
                                   placeholder="Notas del equipo COMEX..."/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button
                        name="action_confirm_release"
                        string="Confirmar Liberación"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
