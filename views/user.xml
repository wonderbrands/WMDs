<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wmds_users_form_inherit" model="ir.ui.view">
        <field name="name">wmds_users_form_inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="qr_image" widget="image" string="QR Code WMDS"/>
                <field name="packer_uuid" widget="barcode" invisible="not packer_uuid" groups="wmds.role_wmds_packer"/>
            </xpath>
        </field>
    </record>
</odoo>