<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View for wmds.mysql.config -->
        <record id="view_wmds_mysql_config_form" model="ir.ui.view">
            <field name="name">wmds.mysql.config.form</field>
            <field name="model">wmds.mysql.config</field>
            <field name="arch" type="xml">
                <form string="Configuración MySqlDriver">
                    <header>
                        <button name="action_test_connection" type="object" string="Probar Conexión" class="oe_highlight"/>
                        <button name="action_sync_sla" type="object" string="Sincronizar SLA Ahora" class="btn-primary"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ej. Amazon RDS SLA"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información General">
                                <field name="marketplace"/>
                                <field name="active"/>
                            </group>
                            <group string="Servidor MySQL">
                                <field name="host"/>
                                <field name="port"/>
                                <field name="user"/>
                                <field name="password" password="True"/>
                                <field name="database"/>
                            </group>
                        </group>
                        <group string="Estructura de Tabla y Mapeo">
                            <group>
                                <field name="table_name"/>
                                <field name="order_id_field"/>
                                <field name="sla_date_field"/>
                            </group>
                            <group string="Estado de Sincronización">
                                <field name="last_sync_date" readonly="1"/>
                            </group>
                        </group>
                        <group string="Log de Última Ejecución">
                            <field name="last_sync_status" nolabel="1" readonly="1" widget="ace" options="{'mode': 'text'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View for wmds.mysql.config -->
        <record id="view_wmds_mysql_config_tree" model="ir.ui.view">
            <field name="name">wmds.mysql.config.list</field>
            <field name="model">wmds.mysql.config</field>
            <field name="arch" type="xml">
                <list string="MySqlDriver Conexiones">
                    <field name="name"/>
                    <field name="marketplace"/>
                    <field name="host"/>
                    <field name="database"/>
                    <field name="table_name"/>
                    <field name="last_sync_date"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Action for MySqlDriver -->
        <record id="action_wmds_mysql_config" model="ir.actions.act_window">
            <field name="name">MySqlDriver (SLA MySQL Sync)</field>
            <field name="res_model">wmds.mysql.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Haz clic para agregar una nueva conexión MySQL para sincronización de SLA.
                </p>
            </field>
        </record>

        <!-- Menuitem under WMDS root menu restricted to wmds_developer and wmds_manager -->
        <menuitem id="menu_wmds_mysql_driver"
                  name="MySqlDriver"
                  action="action_wmds_mysql_config"
                  parent="wmds_menu"
                  sequence="90"
                  groups="wmds.group_wmds_developer,wmds.group_wmds_manager"/>

        <!-- Menuitem under Sale config menu restricted to wmds_developer and wmds_manager -->
        <menuitem id="menu_sale_wmds_mysql_driver"
                  name="MySqlDriver SLA MySQL"
                  action="action_wmds_mysql_config"
                  parent="sale.menu_sale_config"
                  sequence="95"
                  groups="wmds.group_wmds_developer,wmds.group_wmds_manager"/>

    </data>
</odoo>
