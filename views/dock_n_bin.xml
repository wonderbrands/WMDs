<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bin_storage" model="ir.actions.act_window">
        <field name="name">Bin Storage Locations</field>
        <field name="res_model">bin.storage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bin_log" model="ir.actions.act_window">
        <field name="name">Bin Logs</field>
        <field name="res_model">bin.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dock_storage" model="ir.actions.act_window">
        <field name="name">Dock Storage Locations</field>
        <field name="res_model">dock.storage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dock_log" model="ir.actions.act_window">
        <field name="name">Dock Logs</field>
        <field name="res_model">dock.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="bin_storage_location_menu"
        name="Storage Locations"
        parent="bin_menu"
        action="action_bin_storage"
        sequence="10"/>

    <menuitem
        id="bin_log_submenu"
        name="Logs"
        parent="bin_menu"
        action="action_bin_log"
        sequence="20"/>

    <menuitem
        id="dock_storage_location_menu"
        name="Storage Locations"
        parent="dock_menu"
        action="action_dock_storage"
        sequence="10"/>

    <menuitem
        id="dock_log_submenu"
        name="Logs"
        parent="dock_menu"
        action="action_dock_log"
        sequence="20"/>


    <record id="action_bin_storage" model="ir.actions.act_window">
        <field name="name">Bins</field>
        <field name="res_model">bin.storage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dock_storage" model="ir.actions.act_window">
        <field name="name">Docks</field>
        <field name="res_model">dock.storage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_bin_storage_list" model="ir.ui.view">
        <field name="name">bin.storage.list</field>
        <field name="model">bin.storage</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'blocked'" decoration-success="state == 'available'">
                <field name="name"/>
                <field name="state" widget="badge" decoration-danger="state == 'blocked'" decoration-success="state == 'available'"/>
            </list>
        </field>
    </record>

    <record id="view_bin_storage_form" model="ir.ui.view">
        <field name="name">bin.storage.form</field>
        <field name="model">bin.storage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de BIN"/>
                        </h1>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    </div>
                    <group>
                        <group>
                            <field name="qr_image" widget="image" class="oe_avatar"/>
                            <field name="qr_code_structure" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paquetes en BIN (E-commerce)">
                            <field name="ei" readonly="1">
                                <list>
                                    <field name="display_name_custom"/>
                                    <field name="so_id"/>
                                    <field name="on_bin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Productos en BIN (Full)">
                            <field name="moves" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="picking_id"/>
                                    <field name="quantity"/>
                                    <field name="on_bin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dock_storage_list" model="ir.ui.view">
        <field name="name">dock.storage.list</field>
        <field name="model">dock.storage</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'blocked'" decoration-success="state == 'available'">
                <field name="name"/>
                <field name="state" widget="badge" decoration-danger="state == 'blocked'" decoration-success="state == 'available'"/>
            </list>
        </field>
    </record>

    <record id="view_dock_storage_form" model="ir.ui.view">
        <field name="name">dock.storage.form</field>
        <field name="model">dock.storage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de DOCK"/>
                        </h1>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    </div>
                    <group>
                        <group>
                            <field name="qr_image" widget="image" class="oe_avatar"/>
                            <field name="qr_code_structure" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paquetes en DOCK (E-commerce)">
                            <field name="ei" readonly="1">
                                <list>
                                    <field name="display_name_custom"/>
                                    <field name="so_id"/>
                                    <field name="on_dock"/>
                                </list>
                            </field>
                        </page>
                        <page string="Productos en DOCK (Full)">
                            <field name="moves" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="picking_id"/>
                                    <field name="quantity"/>
                                    <field name="on_dock"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bin_log_form" model="ir.ui.view">
        <field name="name">bin.log.form</field>
        <field name="model">bin.log</field>
        <field name="arch" type="xml">
            <form edit="0" create="0">
                <sheet>
                    <group>
                        <field name="bin_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Líneas de Log">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="counted_at"/>
                                    <field name="operator_id"/>
                                    <field name="message"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--DISPATCH-->

    <record id="view_dispatch_sheet_list" model="ir.ui.view">
        <field name="name">wmds.dispatch.sheet.list</field>
        <field name="model">wmds.dispatch.sheet</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="name"/>
                <field name="session_id"/>
                <field name="operator_id"/>
                <field name="date_dispatched"/>
                <field name="total_packages"/>
                <field name="so_names"/>
                <button name="action_download_pdf" type="object"
                        string="Descargar" icon="fa-download"/>
                <button name="action_reprint" type="object"
                        string="Reimprimir" icon="fa-print"/>
            </list>
        </field>
    </record>

    <record id="view_dispatch_sheet_form" model="ir.ui.view">
        <field name="name">wmds.dispatch.sheet.form</field>
        <field name="model">wmds.dispatch.sheet</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_download_pdf" type="object"
                            string="Descargar PDF" class="btn-primary" icon="fa-download"/>
                    <button name="action_reprint" type="object"
                            string="Reimprimir en IoT" class="btn-secondary" icon="fa-print"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="operator_id"/>
                        </group>
                        <group>
                            <field name="date_dispatched"/>
                            <field name="total_packages"/>
                            <field name="so_names"/>
                        </group>
                    </group>
                    <group>
                        <field name="pdf_file" filename="pdf_filename" widget="binary"/>
                        <field name="pdf_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dispatch_sheet" model="ir.actions.act_window">
        <field name="name">Hojas de Salida</field>
        <field name="res_model">wmds.dispatch.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- dispatch menu al mismo nivel de bin y pack-->
    <menuitem
        id="dispatch_sheet_menu"
        name="Dispatch"
        parent="wmds_menu"
        action="action_dispatch_sheet"
        sequence="90"/>
    
</odoo>