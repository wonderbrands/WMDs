<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wmds_stock_pick_batch_inherit" model="ir.ui.view">
            <field name="name">wmds.stock.pick.batch.inherit</field>
            <field name="model">stock.picking.batch</field>
            <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="WMDS" name="wmds_logs">
                        <group>
                            <field name="operator"/>
                            <field name="wmds_status" readonly="1"/>
                        </group>
                        <field name="wmds_log" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="log"/>
                                <field name="date"/>
                                <field name="user"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
