<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="wmds_sale_order_inherit" model="ir.ui.view">
            <field name="name">wmds.sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="WMDS" name="wmds_logs">
                        <field name="wmds_log">
                            <list>
                                <field name="log"/>
                                <field name="date"/>
                                <field name="user"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
