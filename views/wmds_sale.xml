<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="wmds_sale_order_inherit" model="ir.ui.view">
            <field name="name">wmds.sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Guias" name="attachments">
                        <field name="attachments">
                            <list create="True" edit="True" editable="bottom">
                                <field name="display_name_custom"/>
                                <field name="on_bin" readonly="True"/>
                                <field name="on_dock" readonly="True"/>
                                <field name="dispatched" readonly="True"/>
                                <field name="attachment" filename="file_name" widget="binary"/>
                                <field name="file_name" invisible="True" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                    <page string="WMDS" name="wmds_logs">
                        <field name="wmds_log">
                            <list>
                                <field name="log"/>
                                <field name="date"/>
                                <field name="user"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
