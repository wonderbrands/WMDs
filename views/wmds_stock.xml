<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================= ACTION ================= -->
        <record id="wmds_status_action" model="ir.actions.act_window">
            <field name="name">WMDS Status</field>
            <field name="res_model">wmds.stock.status</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ================= MENUS ================= -->
        <menuitem
            id="wmds_parent"
            name="WMDS"
            parent="stock.menu_stock_config_settings"
            groups="wmds.group_wmds_manager"
            sequence="60"
        />

        <menuitem
            id="wmds_status_entry"
            name="WMDS Status"
            parent="wmds_parent"
            action="wmds.wmds_status_action"
            groups="wmds.group_wmds_manager"
            sequence="10"
        />

        <!-- ================= LIST VIEW ================= -->
        <record id="wmds_status_view_list" model="ir.ui.view">
            <field name="name">wmds.stock.status.list</field>
            <field name="model">wmds.stock.status</field>
            <field name="arch" type="xml">
                <list string="WMDS Status">
                    <field name="name"/>
                    <field name="value"/>
                </list>
            </field>
        </record>

        <!-- ================= FORM VIEW ================= -->
        <record id="wmds_status_view_form" model="ir.ui.view">
            <field name="name">wmds.stock.status.form</field>
            <field name="model">wmds.stock.status</field>
            <field name="arch" type="xml">
                <form string="WMDS Status">
                    <sheet>
                        <group>
                            <field name="name" required="1"    />
                            <field name="value" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================= STOCK PICKING INHERIT ================= -->
        <record id="wmds_stock_pick_inherit" model="ir.ui.view">
            <field name="name">wmds.stock.pick.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="attributes">
                    <attribute name="domain">[('complete_name', 'not ilike', 'Bloqueado')]</attribute>
                </xpath>
                <xpath expr="//field[@name='location_dest_id']" position="attributes">
                    <attribute name="domain">[('complete_name', 'not ilike', 'Bloqueado')]</attribute>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="WMDS" name="wmds_logs">
                        <group>
                            <field name="operator"/>
                            <field name="wmds_status"/>
                        </group>
                        <field name="wmds_log">
                            <list>
                                <field name="log"/>
                                <field name="date"/>
                                <field name="user"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- ================= STOCK LOCATION INHERIT ================= -->
        <record id="wmds_stock_location_inherit" model="ir.ui.view">
            <field name="name">wmds.stock.location.inherit</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="action_open_block_wizard" 
                                string="Bloquear Ubicación" 
                                type="object" 
                                class="btn-warning"
                                invisible="block_reason != False"/>
                        <button name="action_unblock" 
                                string="Desbloquear" 
                                type="object" 
                                class="btn-success"
                                invisible="block_reason == False"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='comment']" position="before">
                    <group string="WMDS Bloqueo" name="wmds_bloqueo">
                        <field name="block_reason" readonly="1" invisible="not block_reason"/>
                        <field name="original_parent_id" readonly="1" invisible="not original_parent_id"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
