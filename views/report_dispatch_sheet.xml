<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════
         HOJA DE SALIDA — Reporte PDF (QWeb)
         Modelo: wmds.dispatch.session
         ═══════════════════════════════════════════ -->

    <template id="report_dispatch_sheet_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <!-- Check if this session is a wholesale order session using safe QWeb loop -->
                <t t-set="is_wholesale" t-value="False"/>
                <t t-foreach="session.line_ids" t-as="line">
                    <t t-if="line.ei_name == line.so_name">
                        <t t-set="is_wholesale" t-value="True"/>
                    </t>
                </t>
                
                <div class="page" style="font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #2c3e50; padding: 15mm;">

                    <!-- ── HEADER ── -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                        <div>
                            <h1 style="margin: 0; font-size: 20pt; color: #2c3e50;">HOJA DE SALIDA</h1>
                            <span style="font-size: 9pt; color: #7f8c8d;">Registro de Despacho a Paquetería</span>
                        </div>
                        <div style="text-align: right; font-size: 9pt; line-height: 1.6; color: #34495e;">
                            <div><strong>Fecha de Despacho:</strong> 
                                <span t-esc="session.date_end" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm:ss'}"/>
                            </div>
                            <div><strong>Operador:</strong> <span t-esc="session.operator_name"/></div>
                            <div><strong>Sesión ID:</strong> #<span t-esc="session.id"/></div>
                            <div t-if="not is_wholesale"><strong>Total Paquetes:</strong> <span t-esc="len(session.line_ids)"/></div>
                        </div>
                    </div>

                    <div style="border-bottom: 2px solid #2c3e50; margin-bottom: 20px;"/>

                    <!-- ── BARCODE DE LA SO PARA ESCANEO (SÓLO MAYOREO) ── -->
                    <t t-if="is_wholesale">
                        <t t-set="first_line" t-value="session.line_ids[0] if session.line_ids else False"/>
                        <t t-if="first_line">
                            <div style="text-align: center; margin: 15px auto; padding: 15px; border: 2px dashed #2c3e50; border-radius: 8px; max-width: 450px; background-color: #f8fafc;">
                                <strong style="font-size: 11pt; color: #2c3e50; display: block; margin-bottom: 8px;">
                                    CÓDIGO DE BARRAS DE PEDIDO PARA DESPACHO
                                </strong>
                                <div style="display: flex; justify-content: center; margin: 10px 0;">
                                    <span t-field="first_line.so_name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 400, 'height': 100, 'img_style': 'max-height: 60px;'}"/>
                                </div>
                                <div style="font-size: 13pt; font-weight: bold; color: #2c3e50; margin-top: 5px;" t-esc="first_line.so_name"/>
                            </div>
                        </t>
                    </t>

                    <!-- ── RESUMEN POR ORDEN (SÓLO ECOMMERCE / NO MAYOREO) ── -->
                    <t t-if="not is_wholesale">
                        <div style="margin-bottom: 20px;">
                            <h3 style="font-size: 12pt; color: #2c3e50; border-bottom: 1px solid #bdc3c7; padding-bottom: 5px; margin-bottom: 10px;">
                                Resumen por Orden
                            </h3>
                            <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                <thead>
                                    <tr>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">#</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Orden SO</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Carrier</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Producto(s)</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">EI Escaneadas</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Total EI</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="so_summary" t-value="session._get_so_summary()"/>
                                    <t t-foreach="so_summary" t-as="summary">
                                        <tr t-attf-style="#{summary_index % 2 == 1 and 'background: #f8f9fa;' or ''}">
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="summary_index + 1"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd; font-weight: bold;">
                                                <span t-esc="summary['so_name']"/><br/>
                                                <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=300&amp;height=50' % summary['so_name']" 
                                                     style="max-width: 140px; max-height: 20px; margin-top: 2px;" alt="SO Barcode"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="summary['carrier_name'] or 'N/A'"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <t t-esc="summary['product_name'] or 'N/A'"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="summary['scanned_count']"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="summary['total_ei']"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <span t-if="summary['scanned_count'] >= summary['total_ei']"
                                                      style="color: #27ae60; font-weight: bold;">COMPLETA</span>
                                                <span t-else=""
                                                      style="color: #e67e22; font-weight: bold;">PARCIAL</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- ── DETALLE DE LA ORDEN (SÓLO MAYOREO) o DETALLE DE ESCANEOS (ECOMMERCE) ── -->
                    <div style="margin-bottom: 20px;">
                        <t t-if="is_wholesale">
                            <h3 style="font-size: 12pt; color: #2c3e50; border-bottom: 1px solid #bdc3c7; padding-bottom: 5px; margin-bottom: 10px;">
                                Productos del Pedido (Detalle)
                            </h3>
                            <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                <thead>
                                    <tr>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left; width: 5%;">#</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left; width: 75%;">Producto</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: right; width: 20%;">Cantidad Pedida</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="first_line" t-value="session.line_ids[0] if session.line_ids else False"/>
                                    <t t-if="first_line">
                                        <t t-set="sale_order" t-value="request.env['sale.order'].sudo().search([('name', '=', first_line.so_name)], limit=1)"/>
                                        <t t-if="sale_order">
                                            <t t-foreach="sale_order.order_line.filtered(lambda l: l.product_id)" t-as="o_line">
                                                <tr t-attf-style="#{o_line_index % 2 == 1 and 'background: #f8f9fa;' or ''}">
                                                    <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                        <t t-esc="o_line_index + 1"/>
                                                    </td>
                                                    <td style="padding: 5px 8px; border-bottom: 1px solid #ddd; font-weight: bold;">
                                                        <span t-field="o_line.product_id.display_name"/>
                                                    </td>
                                                    <td style="padding: 5px 8px; border-bottom: 1px solid #ddd; text-align: right;">
                                                        <span t-field="o_line.product_uom_qty"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <h3 style="font-size: 12pt; color: #2c3e50; border-bottom: 1px solid #bdc3c7; padding-bottom: 5px; margin-bottom: 10px;">
                                Detalle de Escaneos
                            </h3>
                            <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                <thead>
                                    <tr>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">#</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Etiqueta EI</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Orden SO</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Producto</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Carrier</th>
                                        <th style="background: #2c3e50; color: white; padding: 6px 8px; text-align: left;">Fecha/Hora Escaneo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="session.line_ids.sorted('scan_datetime')" t-as="line">
                                        <tr t-attf-style="#{line_index % 2 == 1 and 'background: #f8f9fa;' or ''}">
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="line_index + 1"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd; font-weight: bold;">
                                                <t t-esc="line.ei_name"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="line.so_name"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <t t-esc="line.product_name or 'N/A'"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <t t-esc="line.carrier_name or 'N/A'"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #ddd;">
                                                <span t-esc="line.scan_datetime" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm:ss'}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>

                    <!-- ── FIRMAS ── -->
                    <div style="display: flex; justify-content: space-around; margin-top: 50px; padding-top: 20px;">
                        <div style="text-align: center; width: 40%;">
                            <div style="border-bottom: 1px solid #2c3e50; margin-bottom: 8px; height: 50px;"/>
                            <span style="font-size: 9pt; color: #7f8c8d;">Operador de Despacho</span>
                        </div>
                        <div style="text-align: center; width: 40%;">
                            <div style="border-bottom: 1px solid #2c3e50; margin-bottom: 8px; height: 50px;"/>
                            <span style="font-size: 9pt; color: #7f8c8d;">Recibe Paquetería</span>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <!-- Wrapper requerido por Odoo -->
    <template id="report_dispatch_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wmds.report_dispatch_sheet_document"/>
            </t>
        </t>
    </template>

    <!-- ── ACCIÓN DE REPORTE (asociable a impresora IoT) ── -->
    <record id="action_report_dispatch_sheet" model="ir.actions.report">
        <field name="name">Data - Hoja de Salida</field>
        <field name="model">wmds.dispatch.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wmds.report_dispatch_sheet_document</field>
        <field name="report_file">wmds.report_dispatch_sheet_document</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_type">report</field>
    </record>

</odoo>